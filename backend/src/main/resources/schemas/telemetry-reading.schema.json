{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Telemetry reading",
	"type": "object",
	"required": ["boat", "battery", "locked", "pluggedIn", "faults"],
	"properties": {
		"boat": { "type": "string", "pattern": "\\S" },
		"battery": { "type": "integer", "minimum": 0, "maximum": 100 },
		"berth": { "type": "string", "format": "uuid" },
		"position": {
			"type": "object",
			"required": ["latitude", "longitude"],
			"properties": {
				"latitude": { "type": "number", "minimum": -90, "maximum": 90 },
				"longitude": { "type": "number", "minimum": -180, "maximum": 180 }
			}
		},
		"locked": { "type": "boolean" },
		"pluggedIn": { "type": "boolean" },
		"faults": { "type": "array", "items": { "type": "string" } }
	}
}
